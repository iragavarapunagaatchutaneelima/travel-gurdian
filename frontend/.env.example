# Travel Guardian Frontend Environment Configuration Example
# Copy this file to .env.local and fill in your keys:
# cp .env.example .env.local

# Google Maps Platform API Key (for Maps JavaScript, Places Autocomplete, Geocoding & Directions/Routing)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-only Google Routes API key used by /api/routes/compute (TWO_WHEELER
# routing). Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# Google Gemini API Key & Model (for the AI Guardian assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server-only FastAPI backend origin. The browser never talks to this
# directly -- Next.js proxies /backend-api/* to it (see next.config.ts), so
# it does not need to be (and must not be) prefixed with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000/api
