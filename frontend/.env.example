# Travel Guardian Frontend Environment Configuration Example
# Copy this file to .env.local and fill in your keys:
# cp .env.example .env.local

# Google Maps Platform API Key (for Maps JavaScript, Places Autocomplete, Geocoding & Directions/Routing)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Service URL (FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Google Gemini API Key & Model (for Safety Engine AI assessments)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
