# =====================================================================
# Travel Guardian -- configuration template (safe to commit, no secrets)
#
#   cp .env.example .env.local        # at the REPOSITORY ROOT
#   node scripts/check-env.mjs        # verify (never prints values)
#
# /.env.local is the ONE canonical file, read by both the Next.js frontend
# and the FastAPI backend. It is gitignored. See ENVIRONMENT.md.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; everything else
# stays on the server.
# =====================================================================

# ---------------- Google Maps Platform ----------------
# [browser] Maps JavaScript, Places, Geocoding, Directions.
# Restrict by HTTP referrer in Google Cloud Console (localhost:3000/*, your domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# [Next.js server, optional] IP-restricted key for Routes API (two-wheeler
# routing) and server-side Places lookups. Falls back to the key above.
GOOGLE_ROUTES_API_KEY=

# ---------------- Gemini (AI Guardian) ----------------
# [Next.js server, optional] Without it, AI Guardian answers from the
# deterministic grounded tool router only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------- Twilio emergency SMS / voice ----------------
# [backend only] Keep TWILIO_DRY_RUN=true until real credentials are set;
# dry run never sends anything and never needs credentials. Either
# TWILIO_AUTH_TOKEN or the TWILIO_API_KEY/TWILIO_API_SECRET pair works for
# auth; either TWILIO_PHONE_NUMBER or TWILIO_MESSAGING_SERVICE_SID works as
# the SMS sender (voice calls need TWILIO_PHONE_NUMBER specifically).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DRY_RUN=true

# ---------------- App wiring ----------------
# [Next.js server] FastAPI origin. Locally, points at `uvicorn app.main:app`.
# On Vercel, the backend is deployed as its OWN separate Vercel project
# (not the same project as the frontend -- see backend/vercel.json), so this
# must be set explicitly to that deployment's URL + /api, e.g.
# https://your-backend-project.vercel.app/api. The /backend-api/* rewrite in
# next.config.ts proxies to whatever this is set to.
BACKEND_API_URL=http://127.0.0.1:8000/api
# [backend] Defaults to local SQLite. On Vercel, if left unset, falls back to
# an EPHEMERAL /tmp SQLite file so the app can boot -- data will NOT persist
# reliably across cold starts there. For real persistence, set this to a
# hosted Postgres (Vercel Postgres, Neon, Supabase, ...), e.g.
# postgresql://user:pass@host/db.
DATABASE_URL=sqlite:///./travel_guardian.db
# [backend] JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# [backend] true = seed.py wipes demo reference tables. Never touches contacts.
SEED_RESET=false
# [backend] true in production to hide /docs, /redoc, /openapi.json.
DISABLE_API_DOCS=false

# ---------------- Keyless live data (no variables needed) ----------------
# Weather: Open-Meteo (api.open-meteo.com), flood: Open-Meteo Flood / GloFAS,
# public alerts: GDACS. All keyless; documented in docs/API_CONFIGURATION.md.
