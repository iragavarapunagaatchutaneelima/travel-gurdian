# Travel Guardian Environment Configuration Example

# Frontend (Google Maps Platform API Key for Maps JavaScript, Places Autocomplete, Geocoding & Directions/Routing)
# Expected to be client-accessible in browser, but MUST be restricted in Google Cloud Console:
# 1. API Enablement:
#    - Maps JavaScript API
#    - Places API (New & Classic Autocomplete)
#    - Geocoding API
#    - Directions API (Routes / Directions Service)
# 2. Application Restrictions (HTTP Referrers):
#    - http://localhost:3000/*
#    - http://127.0.0.1:3000/*
#    - https://your-production-domain.com/*
# 3. Billing:
#    - Valid Google Cloud billing account associated with project to avoid OVER_QUERY_LIMIT
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend / Server (API Key and Model for Google Gemini Generative AI)
# Stored securely on server-side, never exposed to client bundles
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server-only Google Routes API key used by /api/routes/compute. If unset,
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is used as a fallback, but a separate,
# non-public key restricted to server IPs (no HTTP referrer restriction) is
# recommended for production.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# Server-only FastAPI backend origin. The Next.js server proxies
# /backend-api/* to this address (see next.config.ts rewrites()) so the
# browser never talks to the backend directly and its origin never needs to
# be added to the CSP connect-src. NOT prefixed with NEXT_PUBLIC_ -- never
# sent to the browser.
BACKEND_API_URL=http://127.0.0.1:8000/api

