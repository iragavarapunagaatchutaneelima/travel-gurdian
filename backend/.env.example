# Travel Guardian Backend Environment Configuration Example
# Copy this file to .env:
# cp .env.example .env

PROJECT_NAME="Travel Guardian API"
API_V1_STR="/api"

# Database connection URL (defaults to local SQLite file in backend directory)
# For MySQL: mysql+pymysql://guardian_user:guardian_password@localhost:3306/travel_guardian
DATABASE_URL=sqlite:///./travel_guardian.db

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Exotel Emergency Communication Configuration
# Server-side only: never expose these credentials to frontend bundles or client code.
# Account Region: Singapore | Host: https://api.exotel.com
EXOTEL_ACCOUNT_SID=senapathiyaswanth1
EXOTEL_SUBDOMAIN=api.exotel.com

# API Key & Token from Exotel dashboard under API Key named 'travel-guardian'
EXOTEL_API_KEY=your_travel_guardian_api_key
EXOTEL_API_TOKEN=your_travel_guardian_api_token

# Your Exotel Virtual Number (ExoPhone) for outbound Caller ID (required for live calls)
EXOTEL_EXOPHONE=your_exotel_exophone

# Optional ExoML Voice App ID (if using custom automated IVR flow)
EXOTEL_APP_ID=

