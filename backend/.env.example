# Travel Guardian Backend Environment Configuration Example
# Copy this file to .env:
# cp .env.example .env

PROJECT_NAME="Travel Guardian API"
API_V1_STR="/api"

# Database connection URL (defaults to local SQLite file in backend directory)
# For MySQL: mysql+pymysql://guardian_user:guardian_password@localhost:3306/travel_guardian
DATABASE_URL=sqlite:///./travel_guardian.db

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Twilio Emergency Communication Configuration
# Server-side only: never expose these credentials to frontend bundles or
# client code (never prefix them with NEXT_PUBLIC_).
# Get these from the Twilio Console: https://console.twilio.com

# Account SID (starts with "AC") and Auth Token, from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio phone number (E.164 format, e.g. +15551234567). REQUIRED for
# BOTH outbound calls (as the Caller ID) AND SMS (as the sender number) --
# without it, dispatch is refused before any credits are spent. Buy/port one
# under "Phone Numbers" -> "Manage" -> "Active Numbers" in the Twilio Console.
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Safety gate: when true (the default), Twilio SMS/call requests are fully
# built and validated but NEVER sent over the network -- the result is
# reported as status "dry_run". Set to false only once TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, and TWILIO_PHONE_NUMBER are all real values. Note:
# Twilio trial accounts can only send to phone numbers verified under
# "Verified Caller IDs" in the Console -- upgrade the account for unrestricted
# delivery.
TWILIO_DRY_RUN=true

# When true, `python seed.py` (also run on container startup) wipes and
# re-inserts demo destinations/alerts. Never set this true in an environment
# with real data you want to keep. Emergency contacts and check-ins are
# NEVER touched by seeding regardless of this setting.
SEED_RESET=false

# Set to true in production to hide /docs, /redoc, and /openapi.json, which
# otherwise expose the full API surface publicly.
DISABLE_API_DOCS=false

