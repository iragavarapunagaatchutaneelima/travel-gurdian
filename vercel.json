{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/backend-api/(.*)", "dest": "backend/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "crons": [
    { "path": "/backend-api/assist/checkin/check-overdue", "schedule": "*/1 * * * *" }
  ]
}
